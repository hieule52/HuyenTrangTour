generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  CUSTOMER
  ADMIN
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id        String   @id @default(cuid())
  name      String?
  email     String   @unique
  image     String?
  googleId  String?  @unique
  role      Role     @default(CUSTOMER)
  reviews   Review[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
  @@index([role])
}

model Service {
  id             String   @id @default(cuid())
  slug           String   @unique
  title          String
  description    String?  @db.Text
  departure      String?
  destination    String?
  priceVnd       Int
  priceUsd       Int
  price4SeatsVnd Int?
  price4SeatsUsd Int?
  price7SeatsVnd Int?
  price7SeatsUsd Int?
  image          String
  category       String   // 'city-tour' | 'inter-city' | 'airport' | 'special-tour'
  vehicle        String?  @default("Xe 4 chỗ & 7 chỗ")
  isActive       Boolean  @default(true)
  isFeatured     Boolean  @default(false)
  titleI18n      Json?    // { vi, en, fr, zh, ko, ja }
  descI18n       Json?    // { vi, en, fr, zh, ko, ja }
  reviews        Review[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([category, isActive])
  @@index([isFeatured])
  @@index([slug])
}

model Review {
  id        String        @id @default(cuid())
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  serviceId String?
  service   Service?      @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  rating    Int           // 1 - 5
  content   String        @db.Text
  locale    String        @default("vi") // 'vi' | 'en' | 'fr' | 'zh' | 'ko' | 'ja'
  status    ReviewStatus  @default(PENDING)
  images    ReviewImage[]
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([status, createdAt])
  @@index([serviceId, status])
  @@index([userId])
}

model ReviewImage {
  id        String   @id @default(cuid())
  reviewId  String
  review    Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  imageUrl  String
  publicId  String?
  createdAt DateTime @default(now())

  @@index([reviewId])
}

model SystemSetting {
  id           String   @id @default("default")
  brandName    String   @default("HUYỀN TRANG TOUR")
  hotline1     String   @default("0364 483 597")
  hotline2     String   @default("0935 637 431")
  email        String   @default("huyentrangtour@gmail.com")
  address      String   @default("147 Phùng Quán, thành phố Huế")
  zaloUrl      String   @default("https://zalo.me/0364483597")
  messengerUrl String   @default("https://m.me/")
  whatsappUrl  String   @default("https://wa.me/84364483597")
  updatedAt    DateTime @updatedAt
}
